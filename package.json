{
	"name": "karma",
	"displayName": "Karma",
	"description": "A colorful VS Code theme",
	"version": "3.1.2",
	"publisher": "sreetamd",
	"author": "Sreetam Das",
	"license": "MIT",
	"galleryBanner": {
		"color": "#0A0E14",
		"theme": "dark"
	},
	"icon": "images/logo.png",
	"scripts": {
		"start": "tsx watch src/index.ts",
		"dev": "pnpm run start",
		"build": "rimraf ./dist && pnpm run typecheck && tsx src/build.ts && tsup src/index.ts",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run build",
		"package": "vsce package",
		"release": "vsce publish"
	},
	"repository": {
		"url": "https://github.com/sreetamdas/karma.git"
	},
	"engines": {
		"vscode": "^1.41.0"
	},
	"categories": [
		"Themes"
	],
	"contributes": {
		"themes": [
			{
				"label": "Karma",
				"uiTheme": "vs-dark",
				"path": "./themes/default.json"
			},
			{
				"label": "Karma (No Italics)",
				"uiTheme": "vs-dark",
				"path": "./themes/default-no-italics.json"
			},
			{
				"label": "Karma Light",
				"uiTheme": "vs",
				"path": "./themes/light.json"
			},
			{
				"label": "Karma Light (No Italics)",
				"uiTheme": "vs",
				"path": "./themes/light-no-italics.json"
			},
			{
				"label": "Karma Legacy",
				"uiTheme": "vs-dark",
				"path": "./themes/Karma-color-theme.json"
			}
		]
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@vscode/vsce": "^4.0.0",
		"rimraf": "^6.1.3",
		"tsup": "^9.0.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"bugs": {
		"url": "https://github.com/sreetamdas/karma/issues"
	},
	"homepage": "https://github.com/sreetamdas/karma#readme",
	"keywords": [
		"Karma",
		"theme",
		"dark",
		"light"
	],
	"packageManager": "pnpm@11.22.0"
}
